{
  "author": "void-returned",
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "4.2.3",
    "@tauri-apps/cli": "2.10.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-jsonc": "3.1.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "eslint-plugin-security": "4.0.0",
    "eslint-plugin-sonarjs": "4.0.3",
    "eslint-plugin-toml": "1.3.1",
    "eslint-plugin-unicorn": "64.0.0",
    "eslint-plugin-yml": "3.3.1",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.2",
    "vite": "8.0.8"
  },
  "license": "MIT",
  "name": "winter",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "prettier --check . && cd src-tauri && cargo fmt --check",
    "format:fix": "prettier --write . && cd src-tauri && cargo fmt",
    "lint": "eslint . --max-warnings 0 && cd src-tauri && cargo clippy -- -D warnings",
    "lint:fix": "eslint . --fix --max-warnings 0 && cd src-tauri && cargo clippy --fix --allow-dirty --allow-staged -- -D warnings",
    "tauri": "tauri",
    "test": "run-s test:frontend test:tauri",
    "test:coverage": "run-s test:coverage:frontend test:coverage:tauri",
    "test:coverage:frontend": "echo 'Frontend coverage not yet configured'",
    "test:coverage:tauri": "cd src-tauri && cargo llvm-cov --all-features --workspace --html",
    "test:frontend": "echo 'No frontend tests configured yet'",
    "test:tauri": "cd src-tauri && cargo test",
    "typecheck": "tsc",
    "validate": "run-s format:fix lint:fix typecheck test"
  },
  "type": "module",
  "version": "0.1.0"
}
